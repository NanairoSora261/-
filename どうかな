<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#101210">
  <title>星見ノート — 観測地ランキング</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #101210;
      --surface: #181b18;
      --surface-2: #20241f;
      --line: #343a32;
      --text: #e7e8df;
      --muted: #a4aa9d;
      --accent: #d7bb78;
      --accent-soft: #332d1e;
      --danger: #cf8177;
      --green: #9cbb91;
      --shadow: 0 16px 38px #0005;
      font-family: "Hiragino Kaku Gothic ProN", "Yu Gothic", Meiryo, system-ui, sans-serif;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--text); line-height: 1.65; }
    button, input, select, textarea { font: inherit; }
    button { cursor: pointer; }
    a { color: var(--accent); }
    .shell { max-width: 1160px; padding: 28px 22px 64px; margin: auto; }
    header { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-bottom:28px; }
    .brand { display:flex; align-items:center; gap:13px; }
    .brand-icon { display:grid; place-items:center; width:44px; height:44px; border:1px solid #554b32; border-radius:14px; color:var(--accent); background:#211f18; font-size:23px; }
    h1 { margin:0; font-size:20px; letter-spacing:.08em; }
    .subtitle { color:var(--muted); font-size:12px; margin:2px 0 0; }
    .privacy { color:var(--muted); border:1px solid var(--line); padding:7px 11px; border-radius:999px; font-size:12px; white-space:nowrap; }
    .privacy span { color:var(--green); margin-right:5px; }
    .intro { padding:24px 26px; border:1px solid #494330; background:linear-gradient(120deg,#211f18,#191b18 65%); border-radius:18px; margin-bottom:22px; }
    .intro h2 { margin:0 0 6px; font-size:20px; font-weight:600; }
    .intro p { color:var(--muted); margin:0; font-size:13px; }
    .toolbar { display:flex; justify-content:space-between; align-items:center; gap:14px; margin:20px 0 14px; }
    .toolbar h2 { font-size:17px; margin:0; }
    .toolbar-actions, .button-row { display:flex; flex-wrap:wrap; gap:9px; }
    .btn { border:1px solid var(--line); background:var(--surface-2); color:var(--text); padding:9px 13px; border-radius:10px; transition:background .15s,border-color .15s; }
    .btn:hover { background:#2b3029; border-color:#596050; }
    .btn.primary { color:#1b1a14; background:var(--accent); border-color:var(--accent); font-weight:700; }
    .btn.primary:hover { background:#e4cc91; }
    .btn.danger { color:var(--danger); }
    .btn.small { padding:6px 10px; font-size:12px; }
    .select-sort { color:var(--text); background:var(--surface); border:1px solid var(--line); border-radius:9px; padding:8px 32px 8px 10px; }
    .summary { display:flex; gap:10px; flex-wrap:wrap; color:var(--muted); font-size:12px; margin:0 0 14px; }
    .summary span { padding:5px 9px; border:1px solid var(--line); border-radius:99px; background:#151815; }
    .cards { display:grid; grid-template-columns:repeat(auto-fill,minmax(min(100%,340px),1fr)); gap:14px; }
    .card { position:relative; border:1px solid var(--line); border-radius:16px; background:var(--surface); padding:18px; box-shadow:var(--shadow); }
    .card.top { border-color:#756442; }
    .card-head { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; }
    .place-title { margin:0; font-size:17px; font-weight:650; }
    .rank { color:var(--accent); font-size:12px; font-weight:700; letter-spacing:.04em; }
    .score { text-align:right; color:var(--accent); font-size:23px; font-weight:700; line-height:1.15; white-space:nowrap; }
    .score small { display:block; font-size:10px; color:var(--muted); font-weight:400; margin-top:4px; }
    .coords { margin:9px 0 14px; font-size:12px; color:var(--muted); }
    .metrics { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
    .metric { padding:9px 10px; background:var(--surface-2); border-radius:9px; min-width:0; }
    .metric label { display:block; color:var(--muted); font-size:10px; }
    .metric strong { display:block; font-size:14px; font-weight:600; margin-top:2px; overflow-wrap:anywhere; }
    .memo { white-space:pre-wrap; overflow-wrap:anywhere; color:#c6c9bf; font-size:12px; margin:13px 0 0; padding-top:11px; border-top:1px solid var(--line); }
    .card-actions { display:flex; justify-content:flex-end; gap:7px; margin-top:13px; }
    .empty { border:1px dashed #495044; border-radius:14px; padding:34px; text-align:center; color:var(--muted); grid-column:1/-1; }
    .form-panel { margin-top:32px; border:1px solid var(--line); border-radius:16px; background:var(--surface); padding:21px; }
    .form-panel h2 { margin:0; font-size:17px; }
    .form-help { margin:4px 0 17px; color:var(--muted); font-size:12px; }
    .fields { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:13px; }
    .field { display:flex; flex-direction:column; gap:5px; }
    .field.wide { grid-column:span 2; }
    .field.full { grid-column:1/-1; }
    .field label { color:#c5c8bd; font-size:12px; }
    .field input, .field select, .field textarea { width:100%; color:var(--text); background:#111411; border:1px solid #3b4138; border-radius:9px; padding:10px 11px; outline:none; }
    .field input:focus, .field select:focus, .field textarea:focus { border-color:var(--accent); box-shadow:0 0 0 2px #d7bb7822; }
    .field textarea { min-height:86px; resize:vertical; }
    .hint { color:#858c80; font-size:10px; }
    .form-error { color:var(--danger); min-height:1.5em; font-size:12px; margin:9px 0 0; }
    .form-actions { display:flex; gap:9px; margin-top:9px; }
    .scoring-note { color:#8f968a; font-size:11px; margin:18px 0 0; }
    footer { margin-top:22px; color:#81877c; font-size:11px; text-align:center; }
    .file-input { display:none; }
    @media (max-width:760px) {
      .shell { padding:19px 14px 42px; }
      header { align-items:flex-start; }
      .privacy { font-size:10px; padding:6px 8px; }
      .intro { padding:19px; }
      .toolbar { align-items:flex-start; flex-direction:column; }
      .toolbar-actions { width:100%; }
      .toolbar-actions .btn { flex:1; }
      .fields { grid-template-columns:repeat(2,minmax(0,1fr)); }
    }
    @media (max-width:430px) {
      h1 { font-size:17px; }
      .subtitle { font-size:10px; }
      .brand-icon { width:38px; height:38px; }
      .fields { gap:10px; }
      .field.wide { grid-column:span 2; }
      .metric { padding:8px; }
      .metric strong { font-size:13px; }
    }
  </style>
</head>
<body>
  <main class="shell">
    <header>
      <div class="brand"><div class="brand-icon" aria-hidden="true">✦</div><div><h1>星見ノート</h1><p class="subtitle">PRIVATE OBSERVING SPOTS</p></div></div>
      <div class="privacy"><span>●</span>データはこのブラウザ内に保存</div>
    </header>

    <section class="intro" aria-label="アプリの説明">
      <h2>暗い空を、次の観測地に。</h2>
      <p>SQM・Ratioの暗さを最優先に、標高と移動時間も加味して観測地を自動ランキングします。</p>
    </section>

    <section aria-labelledby="list-title">
      <div class="toolbar">
        <h2 id="list-title">観測地ランキング</h2>
        <div class="toolbar-actions">
          <button class="btn" id="export-btn" type="button">↓ JSONを書き出す</button>
          <button class="btn" id="import-btn" type="button">↑ JSONを追加</button>
          <input class="file-input" id="import-file" type="file" accept=".json,application/json">
          <select class="select-sort" id="sort-select" aria-label="並び替え">
            <option value="score">総合スコア順</option>
            <option value="sqm">SQM（暗さ）順</option>
            <option value="time">移動時間が短い順</option>
          </select>
        </div>
      </div>
      <div class="summary" id="summary" aria-live="polite"></div>
      <div class="cards" id="cards"></div>
    </section>

    <section class="form-panel" aria-labelledby="form-title">
      <h2 id="form-title">観測地を登録</h2>
      <p class="form-help">記録を追加すると、このブラウザに自動保存されます。</p>
      <form id="site-form" novalidate>
        <input type="hidden" id="site-id">
        <div class="fields">
          <div class="field wide"><label for="name">観測地名 *</label><input id="name" name="name" required maxlength="100" placeholder="例：上士幌エリア"></div>
          <div class="field wide"><label for="coords">緯度・経度 *</label><input id="coords" name="coords" required placeholder="43.24103, 142.93870"><span class="hint">緯度, 経度 の形式</span></div>
          <div class="field"><label for="sqm">SQM値 *</label><input id="sqm" name="sqm" type="number" required step="any" min="0" placeholder="21.86"></div>
          <div class="field"><label for="ratio">Ratio値 *</label><input id="ratio" name="ratio" type="number" required step="any" min="0" placeholder="0.134"></div>
          <div class="field"><label for="brightness">Brightness</label><input id="brightness" name="brightness" type="number" step="any" min="0" placeholder="0.196"></div>
          <div class="field"><label for="artifBri">Artif, Bri</label><input id="artifBri" name="artifBri" type="number" step="any" min="0" placeholder="24.3"></div>
          <div class="field"><label for="bortle">Bortle Class</label><select id="bortle" name="bortle"><option value="">未設定</option><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option><option>7</option><option>8</option><option>9</option></select></div>
          <div class="field"><label for="altitude">標高 (m) *</label><input id="altitude" name="altitude" type="number" required step="any" min="0" placeholder="311"></div>
          <div class="field"><label for="travelTime">移動時間 (分) *</label><input id="travelTime" name="travelTime" type="number" required step="any" min="0" placeholder="120"></div>
          <div class="field full"><label for="memo">現地メモ</label><textarea id="memo" name="memo" maxlength="2000" placeholder="視界の抜け、路面状況、風の強さなど"></textarea></div>
        </div>
        <p class="form-error" id="form-error" role="alert"></p>
        <div class="form-actions"><button class="btn primary" type="submit" id="save-btn">観測地を保存</button><button class="btn" type="button" id="cancel-edit" hidden>編集をキャンセル</button></div>
      </form>
      <p class="scoring-note">スコアは登録済みの観測地間で比較する相対評価です。暗さ 60%（SQM・Ratio 各30%）／標高 20%／移動時間 20%。高いSQM・標高、低いRatio・移動時間ほど高得点になります。</p>
    </section>
    <footer>星空の暗さは天候・月齢・周辺環境によって変わります。観測前に現地情報をご確認ください。</footer>
  </main>
<script>
(() => {
  'use strict';
  const STORAGE_KEY = 'hoshimi-note-sites-v1';
  const SAMPLE = {
    id: 'sample-kamishihoro', name: '上士幌エリア（サンプル）', coords: '43.24103, 142.93870',
    sqm: 21.86, ratio: 0.134, brightness: 0.196, artifBri: 24.3, bortle: 3,
    altitude: 311, travelTime: 120, memo: '天頂は非常に暗い。地平線付近にわずかな明かりあり。'
  };
  const $ = (id) => document.getElementById(id);
  const form = $('site-form');
  let sites = loadSites();
  let sortMode = 'score';

  function loadSites() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved !== null) {
        const parsed = JSON.parse(saved);
        if (Array.isArray(parsed)) return parsed.filter(isValidSite).map(normalizeSite);
      }
    } catch (error) { console.warn('保存データを読み込めませんでした。', error); }
    return [{ ...SAMPLE }];
  }
  function isValidSite(site) {
    return site && typeof site === 'object' && typeof site.name === 'string' && typeof site.coords === 'string' &&
      Number.isFinite(Number(site.sqm)) && Number.isFinite(Number(site.ratio)) &&
      Number.isFinite(Number(site.altitude)) && Number.isFinite(Number(site.travelTime));
  }
  function normalizeSite(site) {
    return { ...site, id: String(site.id || makeId()), name: String(site.name), coords: String(site.coords),
      sqm: Number(site.sqm), ratio: Number(site.ratio), altitude: Number(site.altitude), travelTime: Number(site.travelTime),
      brightness: optionalNumber(site.brightness), artifBri: optionalNumber(site.artifBri),
      bortle: site.bortle === '' || site.bortle == null ? '' : Number(site.bortle), memo: String(site.memo || '') };
  }
  function optionalNumber(value) { return value === '' || value == null || !Number.isFinite(Number(value)) ? null : Number(value); }
  function makeId() { return globalThis.crypto?.randomUUID?.() || `site-${Date.now()}-${Math.random().toString(36).slice(2)}`; }
  function persist() {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(sites)); }
    catch (error) { alert('ブラウザへの保存に失敗しました。空き容量やプライベートブラウズの設定をご確認ください。'); console.error(error); }
  }
  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' })[char]);
  }
  function numberText(value, digits = 2) { return value == null || value === '' ? '—' : Number(value).toFixed(digits).replace(/\.?0+$/, (match) => match.includes('.') ? '' : match); }
  function minMaxScore(value, values, higherIsBetter) {
    const min = Math.min(...values), max = Math.max(...values);
    if (max === min) return 100;
    const normalized = (value - min) / (max - min);
    return (higherIsBetter ? normalized : 1 - normalized) * 100;
  }
  function scoredSites() {
    if (!sites.length) return [];
    const sqms = sites.map(s => s.sqm), ratios = sites.map(s => s.ratio);
    const altitudes = sites.map(s => s.altitude), times = sites.map(s => s.travelTime);
    return sites.map(site => ({ ...site, score:
      minMaxScore(site.sqm, sqms, true) * .30 +
      minMaxScore(site.ratio, ratios, false) * .30 +
      minMaxScore(site.altitude, altitudes, true) * .20 +
      minMaxScore(site.travelTime, times, false) * .20
    }));
  }
  function mapUrl(coords) {
    const match = coords.trim().match(/^\s*(-?\d+(?:\.\d+)?)\s*[,，]\s*(-?\d+(?:\.\d+)?)\s*$/);
    if (!match) return null;
    const lat = Number(match[1]), lng = Number(match[2]);
    if (lat < -90 || lat > 90 || lng < -180 || lng > 180) return null;
    return `https://www.google.com/maps?q=${encodeURIComponent(`${lat},${lng}`)}`;
  }
  function render() {
    const result = scoredSites();
    result.sort((a,b) => sortMode === 'sqm' ? b.sqm - a.sqm || b.score-a.score : sortMode === 'time' ? a.travelTime - b.travelTime || b.score-a.score : b.score - a.score);
    $('summary').innerHTML = `<span>登録 ${sites.length} 件</span><span>暗さを最優先した相対スコア</span>`;
    const cards = $('cards');
    if (!result.length) { cards.innerHTML = '<div class="empty">観測地はまだありません。下のフォームから登録してください。</div>'; return; }
    cards.innerHTML = result.map((site, index) => {
      const url = mapUrl(site.coords);
      const coords = url ? `<a href="${url}" target="_blank" rel="noopener noreferrer" aria-label="${escapeHtml(site.name)}をGoogleマップで開く">⌖ ${escapeHtml(site.coords)}</a>` : escapeHtml(site.coords);
      return `<article class="card ${index === 0 && sortMode === 'score' ? 'top' : ''}">
        <div class="card-head"><div><div class="rank">${index + 1} 位</div><h3 class="place-title">${escapeHtml(site.name)}</h3></div><div class="score">${site.score.toFixed(1)}<small>総合スコア / 100</small></div></div>
        <div class="coords">${coords}</div>
        <div class="metrics">
          <div class="metric"><label>SQM</label><strong>${numberText(site.sqm)}</strong></div>
          <div class="metric"><label>Ratio</label><strong>${numberText(site.ratio, 3)}</strong></div>
          <div class="metric"><label>Bortle</label><strong>${site.bortle ? `Class ${escapeHtml(site.bortle)}` : '—'}</strong></div>
          <div class="metric"><label>標高</label><strong>${numberText(site.altitude, 0)} m</strong></div>
          <div class="metric"><label>移動時間</label><strong>${numberText(site.travelTime, 0)} 分</strong></div>
          <div class="metric"><label>Brightness / Artif, Bri</label><strong>${numberText(site.brightness)} / ${numberText(site.artifBri)}</strong></div>
        </div>
        ${site.memo ? `<p class="memo">${escapeHtml(site.memo)}</p>` : ''}
        <div class="card-actions"><button class="btn small" type="button" data-action="edit" data-id="${escapeHtml(site.id)}">編集</button><button class="btn small danger" type="button" data-action="delete" data-id="${escapeHtml(site.id)}">削除</button></div>
      </article>`;
    }).join('');
  }
  function resetForm() { form.reset(); $('site-id').value = ''; $('form-title').textContent = '観測地を登録'; $('save-btn').textContent = '観測地を保存'; $('cancel-edit').hidden = true; $('form-error').textContent = ''; }
  function editSite(id) {
    const site = sites.find(item => item.id === id); if (!site) return;
    $('site-id').value = site.id;
    ['name','coords','sqm','ratio','brightness','artifBri','bortle','altitude','travelTime','memo'].forEach(key => $(key).value = site[key] ?? '');
    $('form-title').textContent = '観測地を編集'; $('save-btn').textContent = '変更を保存'; $('cancel-edit').hidden = false;
    $('form-error').textContent = ''; $('form-title').scrollIntoView({ behavior:'smooth', block:'center' }); $('name').focus({ preventScroll:true });
  }
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const error = $('form-error'); error.textContent = '';
    const coordsValue = $('coords').value.trim();
    if (!mapUrl(coordsValue)) { error.textContent = '緯度・経度は「43.24103, 142.93870」の形式で入力してください（緯度 -90〜90、経度 -180〜180）。'; $('coords').focus(); return; }
    if (!form.reportValidity()) return;
    const site = normalizeSite({ id: $('site-id').value || makeId(), name: $('name').value.trim(), coords: coordsValue,
      sqm: $('sqm').value, ratio: $('ratio').value, brightness: $('brightness').value, artifBri: $('artifBri').value,
      bortle: $('bortle').value, altitude: $('altitude').value, travelTime: $('travelTime').value, memo: $('memo').value.trim() });
    const existing = sites.findIndex(item => item.id === site.id);
    if (existing >= 0) sites[existing] = site; else sites.push(site);
    persist(); resetForm(); render(); $('list-title').scrollIntoView({ behavior:'smooth', block:'start' });
  });
  $('cancel-edit').addEventListener('click', resetForm);
  $('cards').addEventListener('click', (event) => {
    const button = event.target.closest('button[data-action]'); if (!button) return;
    const id = button.dataset.id;
    if (button.dataset.action === 'edit') editSite(id);
    if (button.dataset.action === 'delete') {
      const site = sites.find(item => item.id === id);
      if (site && confirm(`「${site.name}」を削除しますか？`)) { sites = sites.filter(item => item.id !== id); if ($('site-id').value === id) resetForm(); persist(); render(); }
    }
  });
  $('sort-select').addEventListener('change', (event) => { sortMode = event.target.value; render(); });
  $('export-btn').addEventListener('click', () => {
    const blob = new Blob([JSON.stringify({ app: '星見ノート', version: 1, exportedAt: new Date().toISOString(), sites }, null, 2)], { type:'application/json' });
    const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = `hoshimi-note-${new Date().toISOString().slice(0,10)}.json`; link.click(); URL.revokeObjectURL(link.href);
  });
  $('import-btn').addEventListener('click', () => $('import-file').click());
  $('import-file').addEventListener('change', async (event) => {
    const file = event.target.files?.[0]; if (!file) return;
    try {
      const parsed = JSON.parse(await file.text());
      const incoming = Array.isArray(parsed) ? parsed : parsed?.sites;
      if (!Array.isArray(incoming)) throw new Error('JSONの中に観測地の配列がありません。');
      const valid = incoming.filter(isValidSite).map(normalizeSite);
      if (!valid.length) throw new Error('読み込める観測地データがありません。');
      if (valid.length !== incoming.length && !confirm(`${incoming.length - valid.length} 件の不正なデータを除外し、${valid.length} 件を追加しますか？`)) return;
      const ids = new Set(sites.map(site => site.id));
      valid.forEach(site => { if (ids.has(site.id)) site.id = makeId(); ids.add(site.id); sites.push(site); });
      persist(); render(); alert(`${valid.length} 件の観測地を追加しました。`);
    } catch (error) { alert(`JSONを読み込めませんでした。\n${error.message}`); }
    finally { event.target.value = ''; }
  });
  render();
})();
</script>
</body>
</html>
