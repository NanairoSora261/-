<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dark Sky Ranking - 純粋光害データ比較</title>
  <style>
    :root {
      --bg-main: #0b0d12;
      --bg-card: #141821;
      --bg-input: #1c222e;
      --border: #2a3242;
      --text-main: #e2e8f0;
      --text-muted: #8b9bb4;
      --accent: #3b82f6;
      --accent-hover: #2563eb;
      --gold: #fbbf24;
      --silver: #cbd5e1;
      --bronze: #d97706;
      --danger: #ef4444;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Hiragino Sans", "Noto Sans JP", sans-serif;
      background-color: var(--bg-main);
      color: var(--text-main);
      line-height: 1.5;
      padding: 16px;
      max-width: 960px;
      margin: 0 auto;
    }
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 20px;
    }
    h1 { font-size: 1.35rem; letter-spacing: 0.03em; color: #f8fafc; }
    .subtitle { font-size: 0.8rem; color: var(--text-muted); }
    .backup-controls { display: flex; gap: 8px; flex-wrap: wrap; }
    button {
      background: var(--bg-input);
      color: var(--text-main);
      border: 1px solid var(--border);
      padding: 8px 14px;
      border-radius: 6px;
      font-size: 0.85rem;
      cursor: pointer;
      transition: 0.15s;
    }
    button:hover { border-color: var(--accent); }
    button.primary {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
      font-weight: 600;
    }
    button.primary:hover { background: var(--accent-hover); }
    button.danger { color: var(--danger); border-color: rgba(239,68,68,0.3); }
    button.danger:hover { background: rgba(239,68,68,0.1); border-color: var(--danger); }

    .panel {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 18px;
      margin-bottom: 24px;
    }
    .panel-title {
      font-size: 1rem;
      font-weight: 600;
      margin-bottom: 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .section-divider {
      grid-column: 1 / -1;
      font-size: 0.78rem;
      color: var(--accent);
      border-bottom: 1px solid var(--border);
      padding-bottom: 4px;
      margin-top: 6px;
      font-weight: 600;
    }
    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 12px;
    }
    .form-group { display: flex; flex-direction: column; gap: 4px; }
    .form-group.full { grid-column: 1 / -1; }
    label { font-size: 0.78rem; color: var(--text-muted); }
    input, select, textarea {
      background: var(--bg-input);
      border: 1px solid var(--border);
      color: var(--text-main);
      padding: 9px 10px;
      border-radius: 6px;
      font-size: 0.9rem;
      width: 100%;
    }
    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: var(--accent);
    }
    textarea { resize: vertical; min-height: 56px; }
    .form-actions {
      margin-top: 14px;
      display: flex;
      gap: 10px;
      justify-content: flex-end;
    }

    .toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 14px;
    }
    .sort-group { display: flex; align-items: center; gap: 8px; }
    .sort-group select { width: auto; padding: 6px 10px; font-size: 0.85rem; }

    .spot-list { display: flex; flex-direction: column; gap: 12px; }
    .spot-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px;
      display: grid;
      grid-template-columns: 56px 1fr;
      gap: 14px;
      align-items: start;
    }
    .rank-badge {
      width: 52px;
      height: 52px;
      border-radius: 8px;
      background: var(--bg-input);
      border: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-weight: 700;
    }
    .rank-1 { border-color: var(--gold); color: var(--gold); }
    .rank-2 { border-color: var(--silver); color: var(--silver); }
    .rank-3 { border-color: var(--bronze); color: var(--bronze); }
    .rank-num { font-size: 1.2rem; line-height: 1.1; }
    .rank-label { font-size: 0.65rem; color: var(--text-muted); }

    .spot-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 8px;
    }
    .spot-name { font-size: 1.1rem; font-weight: 700; color: #f8fafc; }
    .score-box {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 2px;
    }
    .score-pill {
      background: rgba(59, 130, 246, 0.15);
      border: 1px solid rgba(59, 130, 246, 0.4);
      color: #93c5fd;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 0.9rem;
      font-weight: 700;
    }
    .score-breakdown {
      font-size: 0.72rem;
      color: var(--text-muted);
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    }
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 8px;
      background: var(--bg-input);
      padding: 10px 12px;
      border-radius: 6px;
      margin-bottom: 8px;
      font-size: 0.85rem;
    }
    .metric-item { display: flex; flex-direction: column; }
    .metric-label { font-size: 0.72rem; color: var(--text-muted); }
    .metric-val { font-weight: 700; color: #f8fafc; }
    .sub-info {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-bottom: 8px;
    }
    .spot-memo {
      font-size: 0.85rem;
      border-left: 2px solid var(--border);
      padding-left: 10px;
      color: #cbd5e1;
      margin-bottom: 10px;
      white-space: pre-wrap;
    }
    .spot-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      font-size: 0.8rem;
    }
    .map-link {
      color: #60a5fa;
      text-decoration: none;
    }
    .map-link:hover { text-decoration: underline; }
    .card-actions { display: flex; gap: 6px; }
    .card-actions button { padding: 4px 10px; font-size: 0.78rem; }

    @media (max-width: 540px) {
      .spot-card { grid-template-columns: 1fr; }
      .rank-badge { width: 100%; height: 36px; flex-direction: row; gap: 6px; }
      .score-box { align-items: flex-start; }
    }
  </style>
</head>
<body>

  <header>
    <div>
      <h1>DARK SKY RANKING</h1>
      <div class="subtitle">純粋光害データ（SQM / Brightness / Artif. bright. / Ratio）評価</div>
    </div>
    <div class="backup-controls">
      <button type="button" onclick="exportData()">JSON書き出し</button>
      <button type="button" onclick="document.getElementById('importFile').click()">JSON読み込み</button>
      <input type="file" id="importFile" accept=".json" style="display:none" onchange="importData(event)">
    </div>
  </header>

  <section class="panel">
    <div class="panel-title">
      <span id="formTitle">新規観測地の登録</span>
    </div>
    <form id="spotForm" onsubmit="saveSpot(event)">
      <input type="hidden" id="editId">
      <div class="form-grid">
        <div class="form-group">
          <label>観測地名 *</label>
          <input type="text" id="name" placeholder="例：上士幌エリア" required>
        </div>
        <div class="form-group">
          <label>Coordinates（緯度・経度）</label>
          <input type="text" id="coords" placeholder="例：43.24103, 142.93870">
        </div>

        <div class="section-divider">▼ 評価対象データ（以下の4項目のみで100点満点を算出）</div>

        <div class="form-group">
          <label>SQM (mag/arcsec²) * [40点満点]</label>
          <input type="number" id="sqm" step="0.01" min="15" max="23" placeholder="例：21.86" required>
        </div>
        <div class="form-group">
          <label>Brightness (mcd/m²) * [20点満点]</label>
          <input type="number" id="brightness" step="0.001" min="0" max="50" placeholder="例：0.194" required>
        </div>
        <div class="form-group">
          <label>Artif. bright. (μcd/m²) * [20点満点]</label>
          <input type="number" id="artif" step="0.1" min="0" max="50000" placeholder="例：22.9" required>
        </div>
        <div class="form-group">
          <label>Ratio（人工光比率） * [20点満点]</label>
          <input type="number" id="ratio" step="0.001" min="0" max="100" placeholder="例：0.134" required>
        </div>

        <div class="section-divider">▼ 参考情報（順位・スコア計算には一切影響しません）</div>

        <div class="form-group">
          <label>Bortle Class（任意）</label>
          <select id="bortle">
            <option value="">未選択</option>
            <option value="1">Class 1</option>
            <option value="2">Class 2</option>
            <option value="3">Class 3</option>
            <option value="4">Class 4</option>
            <option value="5">Class 5</option>
            <option value="6">Class 6</option>
            <option value="7">Class 7</option>
            <option value="8">Class 8</option>
            <option value="9">Class 9</option>
          </select>
        </div>
        <div class="form-group">
          <label>Elevation / 標高 (m)（任意）</label>
          <input type="number" id="elevation" step="1" min="0" max="4000" placeholder="例：311">
        </div>
        <div class="form-group full">
          <label>メモ（任意）</label>
          <textarea id="memo" placeholder="例：南側の低空まで暗い。車横付け可。"></textarea>
        </div>
      </div>
      <div class="form-actions">
        <button type="button" id="cancelEditBtn" style="display:none" onclick="resetForm()">キャンセル</button>
        <button type="submit" class="primary" id="submitBtn">ランキングに登録</button>
      </div>
    </form>
  </section>

  <section>
    <div class="toolbar">
      <div style="font-weight:600; font-size:1rem;">登録済みランキング（<span id="spotCount">0</span>件）</div>
      <div class="sort-group">
        <label for="sortBy">並び替え基準：</label>
        <select id="sortBy" onchange="renderList()">
          <option value="score">総合暗さスコア順（4項目合計）</option>
          <option value="sqm">SQM順（数値が高い順）</option>
          <option value="brightness">Brightness順（数値が低い順）</option>
          <option value="artif">Artif. bright.順（数値が低い順）</option>
          <option value="ratio">Ratio順（数値が低い順）</option>
        </select>
      </div>
    </div>
    <div class="spot-list" id="spotList"></div>
  </section>

  <script>
    const STORAGE_KEY = 'dark_sky_spots_pure_v1';

    const defaultSpots = [
      {
        id: 'sample-1',
        name: '上士幌エリア（サンプル）',
        coords: '43.24103, 142.93870',
        sqm: 21.86,
        brightness: 0.194,
        artif: 22.9,
        ratio: 0.134,
        bortle: '3',
        elevation: 311,
        memo: '天頂は非常に暗い。地平線付近にわずかな明かりあり。'
      }
    ];

    let spots = loadSpots();

    function loadSpots() {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(defaultSpots));
        return [...defaultSpots];
      }
      try {
        return JSON.parse(raw);
      } catch (e) {
        return [...defaultSpots];
      }
    }

    function persistSpots() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(spots));
    }

    function clamp(val, min, max) {
      return Math.max(min, Math.min(max, val));
    }

    // 純粋な光学・光害4指標のみで100点満点を計算
    function calcDetails(s) {
      // SQM: 21.00(0点) 〜 22.00(40点)
      const pSqm = clamp(((s.sqm - 21.00) / (22.00 - 21.00)) * 40, 0, 40);
      // Brightness: 0.400(0点) 〜 0.170(20点)
      const pBright = clamp(((0.400 - s.brightness) / (0.400 - 0.170)) * 20, 0, 20);
      // Artif. bright.: 200(0点) 〜 0(20点)
      const pArtif = clamp(((200 - s.artif) / 200) * 20, 0, 20);
      // Ratio: 1.000(0点) 〜 0.000(20点)
      const pRatio = clamp(((1.000 - s.ratio) / 1.000) * 20, 0, 20);

      const total = pSqm + pBright + pArtif + pRatio;
      return {
        total: Math.round(total * 10) / 10,
        pSqm: pSqm.toFixed(1),
        pBright: pBright.toFixed(1),
        pArtif: pArtif.toFixed(1),
        pRatio: pRatio.toFixed(1)
      };
    }

    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&')
        .replace(/</g, '<')
        .replace(/>/g, '>')
        .replace(/"/g, '"')
        .replace(/'/g, ''');
    }

    function saveSpot(e) {
      e.preventDefault();
      const editId = document.getElementById('editId').value;
      const elevVal = document.getElementById('elevation').value;

      const spotData = {
        id: editId || 'spot-' + Date.now(),
        name: document.getElementById('name').value.trim(),
        coords: document.getElementById('coords').value.trim(),
        sqm: parseFloat(document.getElementById('sqm').value),
        brightness: parseFloat(document.getElementById('brightness').value),
        artif: parseFloat(document.getElementById('artif').value),
        ratio: parseFloat(document.getElementById('ratio').value),
        bortle: document.getElementById('bortle').value,
        elevation: elevVal !== '' ? parseInt(elevVal, 10) : null,
        memo: document.getElementById('memo').value.trim()
      };

      if (editId) {
        const idx = spots.findIndex(item => item.id === editId);
        if (idx !== -1) spots[idx] = spotData;
      } else {
        spots.push(spotData);
      }

      persistSpots();
      resetForm();
      renderList();
    }

    function editSpot(id) {
      const s = spots.find(item => item.id === id);
      if (!s) return;
      document.getElementById('editId').value = s.id;
      document.getElementById('name').value = s.name;
      document.getElementById('coords').value = s.coords || '';
      document.getElementById('sqm').value = s.sqm;
      document.getElementById('brightness').value = s.brightness;
      document.getElementById('artif').value = s.artif;
      document.getElementById('ratio').value = s.ratio;
      document.getElementById('bortle').value = s.bortle || '';
      document.getElementById('elevation').value = s.elevation !== null ? s.elevation : '';
      document.getElementById('memo').value = s.memo || '';

      document.getElementById('formTitle').textContent = '観測地データの編集';
      document.getElementById('submitBtn').textContent = '変更を保存';
      document.getElementById('cancelEditBtn').style.display = 'inline-block';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function deleteSpot(id) {
      if (!confirm('この観測地データを削除しますか？')) return;
      spots = spots.filter(item => item.id !== id);
      persistSpots();
      renderList();
    }

    function resetForm() {
      document.getElementById('spotForm').reset();
      document.getElementById('editId').value = '';
      document.getElementById('formTitle').textContent = '新規観測地の登録';
      document.getElementById('submitBtn').textContent = 'ランキングに登録';
      document.getElementById('cancelEditBtn').style.display = 'none';
    }

    function renderList() {
      const sortBy = document.getElementById('sortBy').value;
      const enriched = spots.map(s => ({ ...s, detail: calcDetails(s) }));

      enriched.sort((a, b) => {
        if (sortBy === 'sqm') return b.sqm - a.sqm; // 高いほど暗い
        if (sortBy === 'brightness') return a.brightness - b.brightness; // 低いほど暗い
        if (sortBy === 'artif') return a.artif - b.artif; // 低いほど暗い
        if (sortBy === 'ratio') return a.ratio - b.ratio; // 低いほど暗い
        return b.detail.total - a.detail.total; // 総合スコア高い順
      });

      document.getElementById('spotCount').textContent = enriched.length;
      const listEl = document.getElementById('spotList');
      listEl.innerHTML = '';

      enriched.forEach((s, index) => {
        const rank = index + 1;
        const rankClass = rank <= 3 ? `rank-${rank}` : '';
        const d = s.detail;

        const mapHtml = s.coords
          ? `<a class="map-link" href="https://www.google.com/maps?q=${encodeURIComponent(s.coords)}" target="_blank" rel="noopener">📍 Googleマップで開く (${escapeHtml(s.coords)})</a>`
          : `<span style="color:var(--text-muted)">座標未登録</span>`;

        const refParts = [];
        if (s.bortle) refParts.push(`Bortle: Class ${escapeHtml(s.bortle)}`);
        if (s.elevation !== null && s.elevation !== undefined && s.elevation !== '') refParts.push(`標高: ${escapeHtml(s.elevation)}m`);
        const subInfoHtml = refParts.length > 0
          ? `<div class="sub-info">参考データ（採点外）：${refParts.join(' / ')}</div>`
          : '';

        const memoHtml = s.memo
          ? `<div class="spot-memo">${escapeHtml(s.memo)}</div>`
          : '';

        const card = document.createElement('div');
        card.className = 'spot-card';
        card.innerHTML = `
          <div class="rank-badge ${rankClass}">
            <span class="rank-num">${rank}</span>
            <span class="rank-label">位</span>
          </div>
          <div>
            <div class="spot-header">
              <div class="spot-name">${escapeHtml(s.name)}</div>
              <div class="score-box">
                <div class="score-pill">${d.total.toFixed(1)} / 100点</div>
                <div class="score-breakdown">SQM:${d.pSqm} + Bright:${d.pBright} + Artif:${d.pArtif} + Ratio:${d.pRatio}</div>
              </div>
            </div>
            <div class="metrics-grid">
              <div class="metric-item">
                <span class="metric-label">SQM (mag/arcsec²)</span>
                <span class="metric-val">${s.sqm.toFixed(2)}</span>
              </div>
              <div class="metric-item">
                <span class="metric-label">Brightness (mcd/m²)</span>
                <span class="metric-val">${s.brightness}</span>
              </div>
              <div class="metric-item">
                <span class="metric-label">Artif. bright. (μcd/m²)</span>
                <span class="metric-val">${s.artif}</span>
              </div>
              <div class="metric-item">
                <span class="metric-label">Ratio</span>
                <span class="metric-val">${s.ratio}</span>
              </div>
            </div>
            ${subInfoHtml}
            ${memoHtml}
            <div class="spot-footer">
              <div>${mapHtml}</div>
              <div class="card-actions">
                <button type="button" onclick="editSpot('${escapeHtml(s.id)}')">編集</button>
                <button type="button" class="danger" onclick="deleteSpot('${escapeHtml(s.id)}')">削除</button>
              </div>
            </div>
          </div>
        `;
        listEl.appendChild(card);
      });
    }

    function exportData() {
      const dataStr = JSON.stringify(spots, null, 2);
      const blob = new Blob([dataStr], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      const date = new Date().toISOString().slice(0, 10);
      a.href = url;
      a.download = `dark-sky-pure-${date}.json`;
      a.click();
      URL.revokeObjectURL(url);
    }

    function importData(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const imported = JSON.parse(e.target.result);
          if (!Array.isArray(imported)) throw new Error('Invalid format');
          if (confirm(`${imported.length}件のデータを読み込みます。現在のデータに上書きしますか？（キャンセルを押すと既存データに追加します）`)) {
            spots = imported;
          } else {
            const existingIds = new Set(spots.map(s => s.id));
            imported.forEach(item => {
              if (!existingIds.has(item.id)) spots.push(item);
            });
          }
          persistSpots();
          renderList();
          alert('データの読み込みが完了しました。');
        } catch (err) {
          alert('JSONファイルの形式が正しくありません。');
        }
        event.target.value = '';
      };
      reader.readAsText(file);
    }

    renderList();
  </script>
</body>
</html>
